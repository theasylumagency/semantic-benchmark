# Jev official System One API (server-side only)
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_API_URL=https://api.typesafe.ai/v1/systemone

# GPT-6 Sol baseline via OpenAI Responses API (server-side only)
BASELINE_API_KEY=
BASELINE_MODEL=gpt-6-sol
BASELINE_REASONING_EFFORT=xhigh
BASELINE_API_URL=https://api.openai.com/v1/responses

# Optional current prices in USD per million tokens. Leave blank to show cost as unavailable.
JEV_INPUT_USD_PER_M=
JEV_OUTPUT_USD_PER_M=
BASELINE_INPUT_USD_PER_M=
BASELINE_OUTPUT_USD_PER_M=

# Required to run experiments in production; optional for local development.
BENCHMARK_ACCESS_TOKEN=

# Set only after reviewing gold labels, prompts, schema and evaluation code.
# Copy the current protocol version shown in the workbench to allow validation runs.
BENCHMARK_FROZEN_PROTOCOL_VERSION=
